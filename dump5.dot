digraph LinkedList {
        graph [
            rankdir=LR,
    bgcolor="transparent",
    nodesep=0.6,
            ranksep=0.9,
            splines=polyline,
            pad=0.3,
            fontname="Helvetica"
        ];
    
    node [
        shape=Mrecord,
        style=filled,
        fillcolor="#FF0000",
        color="#374151",
        fontname="Helvetica",
        fontsize=12,
        penwidth=1.5
    ];
    
    edge [
        arrowsize=0.7,
        penwidth=1.7,
        color="#EF4444",
        dir=forward
    ];
    
        subgraph cluster_used {
            label="USED LIST | size = 5";
            style="rounded,filled";
            color="#99F6E4";
            fillcolor="#F0FDFA";
            fontcolor="#0F766E";
            fontsize=17;
            margin=25;
a0 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#DBEAFE" COLOR="#3B82F6"><TR><TD ROWSPAN="2">prev: 1</TD><TD>SENTINEL #0</TD><TD ROWSPAN="2">next: 4</TD></TR><TR><TD>value: 0</TD></TR></TABLE>>];
a0 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFFFFF"><TR><TD ROWSPAN="2" >prev: 1</TD><TD>NODE #0</TD><TD ROWSPAN="2" >next: 4</TD></TR><TR><TD>value: 0</TD></TR></TABLE>>];
a0 -> a4 [dir=both, color="#374151"];
a1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFFFFF"><TR><TD ROWSPAN="2" >prev: 2</TD><TD>NODE #1</TD><TD ROWSPAN="2" >next: 0</TD></TR><TR><TD>value: 3</TD></TR></TABLE>>];
a1 -> a0 [dir=both, color="#374151"];
a2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFFFFF"><TR><TD ROWSPAN="2" >prev: 3</TD><TD>NODE #2</TD><TD ROWSPAN="2" >next: 1</TD></TR><TR><TD>value: 4</TD></TR></TABLE>>];
a2 -> a1 [dir=both, color="#374151"];
a3 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFFFFF"><TR><TD ROWSPAN="2" >prev: 4</TD><TD>NODE #3</TD><TD ROWSPAN="2" >next: 2</TD></TR><TR><TD>value: 5</TD></TR></TABLE>>];
a3 -> a2 [dir=both, color="#374151"];
a4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFFFFF"><TR><TD ROWSPAN="2" >prev: 0</TD><TD>NODE #4</TD><TD ROWSPAN="2" >next: 3</TD></TR><TR><TD>value: 6</TD></TR></TABLE>>];
a4 -> a3 [dir=both, color="#374151"];
}
subgraph cluster_free {
        label="FREE LIST | free_head = 5";
        style="rounded,filled";
        color="#CBD5E1";
        fillcolor="#F8FAFC";
        fontcolor="#64748B";
        fontsize=17;
        margin=25;

        node [
            fillcolor="#E2E8F0",
            color="#94A3B8"
        ];
b5 [label="{FREE #5|prev: -1|next: 6}"];
b6 [label="{FREE #6|prev: -1|next: 7}"];
b7 [label="{FREE #7|prev: -1|next: -1}"];
null [
         label="NULL",
         shape=oval,
         fillcolor="#FEE2E2",
         color="#EF4444",
         fontcolor="#B91C1C"
     ];
edge [color="#94A3B8"];
b5 -> b6;
b6 -> b7;
b7 -> null [style=dashed];
}
}
