
digraph LinkedList {
    graph [
        rankdir=LR,
        bgcolor="transparent",
        nodesep=0.6,
        ranksep=0.9,
        splines=polyline,
        pad=0.3,
        fontname="Helvetica"
    ];

    node [
        shape=Mrecord,
        style=filled,
        fontname="Helvetica",
        fontsize=12,
        penwidth=1.5
    ];

    edge [
        arrowsize=0.7,
        penwidth=1.7
    ];

    // =========================
    // USED LIST
    // =========================

    subgraph cluster_used {
        label="USED LIST | size = 2";
        style="rounded,filled";
        color="#99F6E4";
        fillcolor="#F0FDFA";
        fontcolor="#0F766E";
        fontsize=17;
        margin=25;

        n0 [
            label="{DUMMY #0|value: 0|{prev: 1|next: 2}}",
            fillcolor="#DBEAFE",
            color="#3B82F6"
        ];

        n2 [
            label="{NODE #2|value: 17|{prev: 0|next: 1}}",
            fillcolor="#CCFBF1",
            color="#0D9488"
        ];

        n1 [
            label="{NODE #1|value: 3|{prev: 2|next: 0}}",
            fillcolor="#CCFBF1",
            color="#0D9488"
        ];

        // NEXT pointers
        n0 -> n2 [color="#0D9488"];
        n2 -> n1 [color="#0D9488"];
        n1 -> n0 [
            color="#0D9488",
            constraint=false
        ];

        // PREV pointers
        n0 -> n1 [
            color="#F59E0B",
            style=dashed,
            constraint=false
        ];

        n1 -> n2 [
            color="#F59E0B",
            style=dashed,
            constraint=false
        ];

        n2 -> n0 [
            color="#F59E0B",
            style=dashed,
            constraint=false
        ];
    }

    // =========================
    // FREE LIST
    // =========================

    subgraph cluster_free {
        label="FREE LIST | free_head = 3";
        style="rounded,filled";
        color="#CBD5E1";
        fillcolor="#F8FAFC";
        fontcolor="#64748B";
        fontsize=17;
        margin=25;

        node [
            fillcolor="#E2E8F0",
            color="#94A3B8"
        ];

        n3 [label="{FREE #3|prev: -1|next: 4}"];
        n4 [label="{FREE #4|prev: -1|next: 5}"];
        n5 [label="{FREE #5|prev: -1|next: 6}"];
        n6 [label="{FREE #6|prev: -1|next: 7}"];
        n7 [label="{FREE #7|prev: -1|next: 8}"];
        n8 [label="{FREE #8|prev: -1|next: 9}"];
        n9 [label="{FREE #9|prev: -1|next: -1}"];

        null [
            label="NULL",
            shape=oval,
            fillcolor="#FEE2E2",
            color="#EF4444",
            fontcolor="#B91C1C"
        ];

        // FREE NEXT pointers
        edge [color="#94A3B8"];

        n3 -> n4;
        n4 -> n5;
        n5 -> n6;
        n6 -> n7;
        n7 -> n8;
        n8 -> n9;
        n9 -> null [style=dashed];
    }

    // Keep clusters vertically aligned
    { rank=same; n0; n3; }
}
